# ============================================
# DevTeam Runtime Files
# ============================================
# These are generated during DevTeam operation
# and should not be committed to version control

# State and runtime files (in user projects)
# Note: The template files in .devteam/ ARE committed
# but runtime state in user projects should be ignored
# NOTE: state.yaml is DEPRECATED - SQLite (.devteam/devteam.db) is the source of truth
.devteam/state.yaml
.devteam/autonomous-mode
.devteam/circuit-breaker.json

# Session memory files
.devteam/memory/

# Runtime logs
.devteam/logs/
.devteam/*.log

# Temporary planning files
.devteam/tmp/
.devteam/scratch/

# MCP server runtime data
.devteam/mcp-cache/

# LSP runtime files
.devteam/lsp-logs/
.devteam/lsp-*.log

# Bug council deliberation files (may contain sensitive info)
.devteam/bug-council-sessions/

# Checkpoint files (can be large)
.devteam/checkpoints/

# Keep configuration templates
!.devteam/config.yaml
!.devteam/agent-capabilities.yaml
# state-schema.yaml and state-example.yaml moved to docs/deprecated/

# Keep scripts/lib and hooks/lib directories (overrides Python lib/ exclusion)
!scripts/lib/
!scripts/lib/**
!hooks/lib/
!hooks/lib/**

# Personal local Claude Code settings (never shared/committed)
.claude/settings.local.json
